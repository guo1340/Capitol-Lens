{
  "name": "capitol-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run types && tsc --noEmit && vite build",
    "types": "wrangler types",
    "preview": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "preview:auth": "wrangler dev --config tests/auth-fixture.jsonc --ip 127.0.0.1 --port 8790",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "dev:backend": "node scripts/backend.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/node": "latest",
    "@cloudflare/workers-types": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
