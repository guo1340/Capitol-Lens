{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capitol-lens",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "aws:us-east-1" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.guopq.com/capitol-lens/*", "zone_name": "guopq.com" }, { "pattern": "www.guopq.com/capitol-lens", "zone_name": "guopq.com" }, { "pattern": "api.guopq.com/capitol-lens/*", "zone_name": "guopq.com" }],
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "ADMIN", "service": "guopq-admin" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "ENVIRONMENT": "production", "GITHUB_REPOSITORY": "guo1340/Capitol-Lens", "GITHUB_REF": "main", "WEBULL_ENVIRONMENT": "production" }
}
